#!/bin/sh
set -eu
# Official tags are immutable and must identify the final master source.
while read -r old new ref; do
    case "$ref" in
      refs/tags/v*)
        printf '%s\n' "$ref" | grep -Eq '^refs/tags/v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || { echo 'Invalid stable version tag' >&2; exit 1; }
        test "$old" = 0000000000000000000000000000000000000000 || { echo 'Stable tags cannot be changed or deleted' >&2; exit 1; }
        target=$(git rev-parse "$new^{commit}")
        master=$(git rev-parse refs/heads/master)
        test "$target" = "$master" || { echo 'Stable tag must point exactly to current master' >&2; exit 1; }
        ;;
    esac
done
