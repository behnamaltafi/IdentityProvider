@page "/account/login"
@model IdentityProvider.Api.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }
<!doctype html>
<html lang="fa" dir="rtl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ورود | IdentityProvider</title>
<style>body{font-family:Tahoma,sans-serif;background:#f4f6fa;color:#182c42;margin:0}main{max-width:440px;margin:5vh auto;padding:32px;background:white;border-radius:18px;box-shadow:0 8px 40px #182c4210}h1{font-size:24px}h2{font-size:18px;margin-top:28px}label{display:block;margin:16px 0 7px}input,button{box-sizing:border-box;width:100%;padding:12px;border-radius:8px;border:1px solid #c7d2df}input{direction:ltr}button{margin-top:16px;background:#204f88;color:white;border:0;cursor:pointer}button.secondary{background:#e5edf7;color:#204f88}p{line-height:1.9}.message{background:#fff4d9;padding:12px;border-radius:8px}small{color:#546679}hr{border:0;border-top:1px solid #e6ebf2;margin-top:28px}</style></head>
<body><main><h1>ورود به حساب</h1><p>با رمز عبور یا کد پیامکی وارد شوید.</p>
@if (!string.IsNullOrEmpty(Model.Message)) { <p class="message" role="status">@Model.Message</p> }
<form method="post" asp-page-handler="Password">
<input type="hidden" asp-for="ReturnUrl">
<label for="UserName">نام کاربری</label><input asp-for="UserName" autocomplete="username" maxlength="128" required>
<label for="Password">رمز عبور</label><input asp-for="Password" type="password" autocomplete="current-password" maxlength="256" required>
<button type="submit">ورود با رمز عبور</button>
<button class="secondary" type="submit" asp-page-handler="Register">ساخت حساب با همین نام و رمز</button>
<small>رمز جدید: حداقل ۱۲ کاراکتر، حروف بزرگ و کوچک، عدد و علامت.</small>
</form><hr><h2>ورود یا ثبت‌نام با پیامک</h2>
<form method="post" asp-page="/Account/SendCode">
<input type="hidden" asp-for="ReturnUrl">
<label for="sms-phone">شماره موبایل</label><input id="sms-phone" name="PhoneNumber" type="tel" autocomplete="tel" placeholder="09123456789" maxlength="32" required>
<button class="secondary" type="submit">ارسال کد ورود</button></form>
<form method="post" asp-page-handler="Sms">
<input type="hidden" asp-for="ReturnUrl">
<label for="verify-phone">شماره موبایل</label><input id="verify-phone" asp-for="PhoneNumber" type="tel" autocomplete="tel" maxlength="32" required>
<label for="Code">کد پیامکی</label><input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required>
<button type="submit">تأیید کد و ورود</button>
<small>اگر حسابی با این شماره نداشته باشید، پس از تأیید کد ساخته می‌شود.</small></form>
</main></body></html>
